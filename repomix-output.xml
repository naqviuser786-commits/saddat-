import React, { useEffect, useRef, useState, useMemo } from "react";
import { Link } from "react-router-dom";
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import { 
  ArrowUpRight, 
  RotateCcw, 
  ShieldCheck, 
  Sparkles, 
  Award, 
  CheckCircle2, 
  ChevronDown,
  MessageSquare,
  Compass,
  MoveHorizontal,
  Plus,
  X
} from "lucide-react";
import ChairFrameSequence, { TOTAL_FRAMES } from "./ChairFrameSequence";
import HeroNavigation from "./HeroNavigation";
import MagneticButton from "../ui/MagneticButton";
import { getGeneralWhatsAppUrl } from "../../utils/whatsapp";

gsap.registerPlugin(ScrollTrigger);

interface FeatureCallout {
  start: number;
  end: number;
  number: string;
  title: string;
  subtitle: string;
  description: string;
  alignment: "left" | "right";
}

interface AnglePreset {
  label: string;
  degree: string;
  frame: number;
}

interface HotspotPin {
  id: string;
  title: string;
  subtitle: string;
  description: string;
  top: string;
  left: string;
  specTag: string;
}

const ROTATION_CALLOUTS: FeatureCallout[] = [
  {
    start: 0.12,
    end: 0.28,
    number: "01",
    title: "High-Tensile AeroMesh",
    subtitle: "ANATOMICAL SPINAL TRACKING",
    description: "Multidirectional breathable matrix eliminates thermal fatigue during 10+ hour executive workdays.",
    alignment: "left",
  },
  {
    start: 0.32,
    end: 0.48,
    number: "02",
    title: "Synchronous Kinematics",
    subtitle: "COLD-FORGED ALLOY CORE",
    description: "Fluid 135° recline with precision 4-point posture memory locking for dynamic ergonomic balance.",
    alignment: "right",
  },
  {
    start: 0.52,
    end: 0.68,
    number: "03",
    title: "Class-4 Star Base",
    subtitle: "BIFMA X5.1 CERTIFIED",
    description: "Mirror-cast structural aluminum alloy star base tested to withstand 150kg+ continuous commercial loads.",
    alignment: "left",
  },
];

const ANGLE_PRESETS: AnglePreset[] = [
  { label: "Front", degree: "0°", frame: 1 },
  { label: "Contour", degree: "45°", frame: 120 },
  { label: "Profile", degree: "90°", frame: 240 },
  { label: "Spine Mesh", degree: "180°", frame: 480 },
  { label: "Kinematics", degree: "270°", frame: 720 },
];

const CHAIR_HOTSPOTS: HotspotPin[] = [
  {
    id: "lumbar",
    title: "Active Spinal Tracking",
    subtitle: "LUMBAR MATRIX",
    description: "Dynamic pivot hinge moves with lower spine to relieve L4-L5 disc compression during 10+ hour workdays.",
    top: "47%",
    left: "50%",
    specTag: "BIFMA Certified",
  },
  {
    id: "mechanism",
    title: "Synchronous Kinematics",
    subtitle: "COLD-FORGED ALLOY",
    description: "Fluid 135° recline with precision 4-point posture memory locking forged from heavy-duty structural alloy.",
    top: "60%",
    left: "52%",
    specTag: "150KG Tested",
  },
  {
    id: "armrest",
    title: "Multi-Axis 3D Armrests",
    subtitle: "ERGONOMIC CORE",
    description: "Height, depth, and angle adjustable with soft-touch polyurethane pads to prevent carpal tunnel strain.",
    top: "50%",
    left: "38%",
    specTag: "PU Padded",
  },
];

export default function LuxuryHero() {
  const containerRef = useRef<HTMLDivElement | null>(null);
  const pinStageRef = useRef<HTMLDivElement | null>(null);

  const [currentFrame, setCurrentFrame] = useState<number>(1);
  const [scrollProgress, setScrollProgress] = useState<number>(0);

  // Drag-to-Rotate State
  const [isDragging, setIsDragging] = useState<boolean>(false);
  const dragStartXRef = useRef<number>(0);
  const dragStartScrollYRef = useRef<number>(0);

  // Interactive Hotspot State
  const [activeHotspotId, setActiveHotspotId] = useState<string | null>(null);

  // GSAP Pinning: 600vh with 0.8s scrub
  useEffect(() => {
    if (!containerRef.current || !pinStageRef.current) return;

    const ctx = gsap.context(() => {
      ScrollTrigger.create({
        trigger: containerRef.current,
        start: "top top",
        end: "bottom bottom",
        pin: pinStageRef.current,
        pinSpacing: false,
        scrub: 0.8,
        anticipatePin: 1,
        onUpdate: (self) => {
          const prog = self.progress;
          setScrollProgress(prog);

          // Chair spins calmly from 0% to 72% of scroll
          const chairProgress = Math.min(1, Math.max(0, prog / 0.72));
          const targetFrame = Math.min(
            TOTAL_FRAMES,
            Math.max(1, Math.round(chairProgress * (TOTAL_FRAMES - 1)) + 1)
          );
          setCurrentFrame(targetFrame);
        },
      });
    }, containerRef);

    return () => ctx.revert();
  }, []);

  // Quick Perspective Angle Selection Handler
  const handleAngleSelect = (targetFrame: number) => {
    if (!containerRef.current) return;
    const container = containerRef.current;
    const containerTop = container.offsetTop;
    const maxScrollHeight = container.offsetHeight - window.innerHeight;

    const targetProgress = ((targetFrame - 1) / (TOTAL_FRAMES - 1)) * 0.72;
    const targetY = containerTop + (targetProgress * maxScrollHeight);

    window.scrollTo({
      top: targetY,
      behavior: "smooth",
    });
  };

  // Drag Gesture Controllers (Mouse & Touch)
  const handleDragStart = (clientX: number) => {
    if (scrollProgress > 0.75) return;
    setIsDragging(true);
    dragStartXRef.current = clientX;
    dragStartScrollYRef.current = window.scrollY;
  };

  const handleDragMove = (clientX: number) => {
    if (!isDragging || !containerRef.current) return;
    const deltaX = clientX - dragStartXRef.current;

    const container = containerRef.current;
    const containerTop = container.offsetTop;
    const maxScrollRange = (container.offsetHeight - window.innerHeight) * 0.72;

    const dragSensitivity = window.innerWidth <= 768 ? 2.2 : 2.8;
    const scrollDelta = -(deltaX * dragSensitivity * (maxScrollRange / (TOTAL_FRAMES * 1.4)));

    const newScrollY = Math.max(
      containerTop,
      Math.min(containerTop + maxScrollRange, dragStartScrollYRef.current + scrollDelta)
    );

    window.scrollTo({
      top: newScrollY,
      behavior: "instant" as ScrollBehavior,
    });
  };

  const handleDragEnd = () => {
    setIsDragging(false);
  };

  // Active Angle Preset Indicator
  const getIsActivePreset = (presetFrame: number) => {
    if (presetFrame === 1 && (currentFrame <= 35 || currentFrame >= 925)) return true;
    return Math.abs(currentFrame - presetFrame) <= 45;
  };

  // Phase 1: Initial "Scroll to Inspect" badge
  const scrollHintOpacity = useMemo(() => {
    if (scrollProgress <= 0.01) return 1;
    if (scrollProgress >= 0.07) return 0;
    return 1 - (scrollProgress - 0.01) / 0.06;
  }, [scrollProgress]);

  // Phase 2: Finale Chair Position
  const chairStageStyles = useMemo(() => {
    if (scrollProgress < 0.72) {
      return {
        transform: "translate3d(0, 0, 0) scale(1)",
        opacity: 1,
      };
    }
    const t = Math.min(1, (scrollProgress - 0.72) / 0.22);
    const translateX = window.innerWidth >= 1024 ? t * 14 : 0;
    return {
      transform: `translate3d(${translateX}%, 0, 0) scale(1.02)`,
      opacity: 1,
    };
  }, [scrollProgress]);

  // Phase 3: Grand Editorial Hero Revelation
  const heroRevealProgress = useMemo(() => {
    if (scrollProgress < 0.72) return 0;
    if (scrollProgress >= 0.92) return 1;
    return (scrollProgress - 0.72) / 0.20;
  }, [scrollProgress]);

  const heroTranslateY = (1 - heroRevealProgress) * 35;

  // Hotspots visibility: active during 360 inspection (0.08 to 0.70)
  const hotspotsVisible = scrollProgress >= 0.08 && scrollProgress <= 0.70;

  return (
    <div
      ref={containerRef}
      className="relative w-full bg-[#18110B] text-stone-100"
      style={{
        height: "600vh",
      }}
    >
      {/* Pinned 100vh Architectural Stage */}
      <div
        ref={pinStageRef}
        className="w-full h-screen overflow-hidden relative flex flex-col justify-between"
        style={{
          background: "radial-gradient(ellipse at 50% 50%, #2B1C12 0%, #1E130B 50%, #120B07 100%)",
        }}
      >
        {/* Navigation */}
        <HeroNavigation />

        {/* Architectural Walnut Slat Paneling Texture */}
        <div 
          className="absolute inset-0 pointer-events-none opacity-20"
          style={{
            backgroundImage: "repeating-linear-gradient(90deg, rgba(197, 168, 128, 0.08) 0px, rgba(197, 168, 128, 0.08) 1px, transparent 1px, transparent 64px)",
          }}
        />

        {/* 1. CHAIR CANVAS (Touch Drag & Free-Spin) */}
        <div 
          onMouseDown={(e) => handleDragStart(e.clientX)}
          onMouseMove={(e) => isDragging && handleDragMove(e.clientX)}
          onMouseUp={handleDragEnd}
          onMouseLeave={handleDragEnd}
          onTouchStart={(e) => handleDragStart(e.touches[0].clientX)}
          onTouchMove={(e) => handleDragMove(e.touches[0].clientX)}
          onTouchEnd={handleDragEnd}
          className={`absolute inset-0 w-full h-full flex items-center justify-center z-10 transition-transform duration-500 ease-out select-none ${
            scrollProgress < 0.72
              ? isDragging ? "cursor-grabbing pointer-events-auto" : "cursor-grab pointer-events-auto"
              : "pointer-events-none"
          }`}
          style={chairStageStyles}
          title="Drag horizontally to spin 360°"
        >
          <ChairFrameSequence
            currentFrame={currentFrame}
            className="w-full h-full"
          />
        </div>

        {/* 2. INTERACTIVE PULSING HOTSPOTS */}
        {hotspotsVisible && (
          <div className="absolute inset-0 z-25 pointer-events-none transition-opacity duration-300">
            {CHAIR_HOTSPOTS.map((spot) => {
              const isActive = activeHotspotId === spot.id;
              return (
                <div
                  key={spot.id}
                  className="absolute pointer-events-auto"
                  style={{ top: spot.top, left: spot.left }}
                >
                  <button
                    onClick={() => setActiveHotspotId(isActive ? null : spot.id)}
                    className="relative -translate-x-1/2 -translate-y-1/2 w-8 h-8 rounded-full flex items-center justify-center focus:outline-none group"
                    title={`Inspect ${spot.title}`}
                  >
                    <span className="absolute inset-0 rounded-full bg-[#C5A880]/30 animate-ping opacity-75" />
                    <span className={`relative w-4 h-4 rounded-full flex items-center justify-center font-bold text-[10px] shadow-lg transition-transform duration-300 ${
                      isActive ? "bg-white text-[#18110B] scale-110" : "bg-[#C5A880] text-[#18110B] group-hover:scale-110"
                    }`}>
                      {isActive ? <X className="w-2.5 h-2.5" /> : <Plus className="w-2.5 h-2.5" />}
                    </span>
                  </button>

                  {isActive && (
                    <div className="absolute top-6 left-1/2 -translate-x-1/2 w-64 bg-[#1C120B]/98 backdrop-blur-2xl border border-[#C5A880]/60 p-4 shadow-2xl text-left z-50 animate-fadeIn">
                      <div className="flex items-center justify-between mb-1">
                        <span className="text-[9px] font-mono tracking-widest uppercase text-[#C5A880] font-bold">
                          {spot.subtitle}
                        </span>
                        <span className="text-[9px] font-mono text-emerald-400 bg-emerald-950/60 border border-emerald-500/30 px-1.5 py-0.2">
                          {spot.specTag}
                        </span>
                      </div>

                      <h4 className="text-sm font-serif font-bold text-white mb-1">
                        {spot.title}
                      </h4>

                      <p className="text-[11px] text-stone-300 leading-relaxed font-light mb-2">
                        {spot.description}
                      </p>

                      <button
                        onClick={() => setActiveHotspotId(null)}
                        className="text-[9px] font-mono text-[#C5A880] uppercase tracking-wider underline hover:text-white"
                      >
                        Close Specification &times;
                      </button>
                    </div>
                  )}
                </div>
              );
            })}
          </div>
        )}

        {/* 3. INITIAL PHASE: "Scroll or Drag to Free-Spin 360°" Notice */}
        <div
          className="relative z-30 w-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pt-24 sm:pt-36 pointer-events-none transition-opacity duration-300 text-left"
          style={{
            opacity: scrollHintOpacity,
            visibility: scrollHintOpacity > 0 ? "visible" : "hidden",
          }}
        >
          <div className="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-[#2A1B12]/85 backdrop-blur-md border border-[#C5A880]/40 text-[9px] sm:text-[10px] font-mono tracking-[0.2em] text-[#E0C6A0] uppercase shadow-sm">
            <RotateCcw className="w-3 h-3 text-[#C5A880] animate-spin" style={{ animationDuration: "14s" }} />
            <span>360° Atelier Inspection</span>
          </div>

          <h2 className="text-2xl sm:text-5xl lg:text-6xl font-serif text-white tracking-tight mt-2.5 max-w-2xl leading-[1.08]">
            Scroll or drag to experience <br />
            <span className="italic font-normal text-[#C5A880]">
              the anatomy of executive posture.
            </span>
          </h2>

          <div className="flex items-center gap-2.5 mt-3 text-[11px] font-mono text-[#C5A880]/90 tracking-wider uppercase">
            <span className="w-1.5 h-1.5 rounded-full bg-[#C5A880] animate-ping" />
            <MoveHorizontal className="w-3.5 h-3.5 text-[#C5A880]" />
            <span>Drag or Scroll to Rotate</span>
          </div>
        </div>

        {/* 4. ROTATION MICRO-CALLOUTS */}
        <div className="absolute inset-0 z-20 pointer-events-none flex items-center">
          <div className="w-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-12">
            {ROTATION_CALLOUTS.map((callout, idx) => {
              const mid = (callout.start + callout.end) / 2;
              const range = (callout.end - callout.start) / 2;
              const dist = Math.abs(scrollProgress - mid);

              let opacity = 0;
              if (scrollProgress >= callout.start && scrollProgress <= callout.end) {
                opacity = 1 - Math.pow(dist / range, 1.8);
                opacity = Math.max(0, Math.min(1, opacity));
              }

              const isLeft = callout.alignment === "left";
              const translateY = (scrollProgress - mid) * 30;

              return (
                <div
                  key={idx}
                  className={`max-w-xs sm:max-w-sm transition-opacity duration-150 ease-out ${
                    isLeft ? "mr-auto text-left" : "ml-auto text-left"
                  }`}
                  style={{
                    opacity,
                    transform: `translate3d(0, ${translateY}px, 0)`,
                    visibility: opacity > 0.05 ? "visible" : "hidden",
                  }}
                >
                  <div className="bg-[#1C120B]/95 backdrop-blur-md p-5 sm:p-6 border-l-2 border-[#C5A880] shadow-2xl border-t border-r border-b border-white/5">
                    <div className="flex items-center justify-between mb-2">
                      <span className="text-[9px] sm:text-[10px] font-mono tracking-[0.25em] text-[#C5A880] uppercase font-bold">
                        {callout.subtitle}
                      </span>
                      <span className="text-xs font-mono text-stone-400">
                        {callout.number}
                      </span>
                    </div>
                    <h3 className="text-lg sm:text-2xl font-serif text-white tracking-tight mb-1.5">
                      {callout.title}
                    </h3>
                    <p className="text-xs text-stone-300 leading-relaxed font-normal">
                      {callout.description}
                    </p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

        {/* 5. FINALE: ARCHITECTURAL WALNUT WOOD & CHAMPAGNE GOLD EDITORIAL STORY */}
        <div
          className="absolute inset-0 z-40 flex items-center justify-start pointer-events-none transition-all duration-300 text-left"
          style={{
            opacity: heroRevealProgress,
            transform: `translate3d(0, ${heroTranslateY}px, 0)`,
            visibility: heroRevealProgress > 0.02 ? "visible" : "hidden",
          }}
        >
          <div className="w-full max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 py-6 sm:py-8 pointer-events-auto">
            <div className="max-w-2xl bg-[#1C120B]/95 backdrop-blur-xl p-6 sm:p-12 border border-[#C5A880]/35 shadow-2xl relative">
              
              <div className="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-[#C5A880] via-[#E8D1B0] to-[#8C6D46]" />

              <div className="inline-flex items-center gap-2 text-[9px] sm:text-xs font-mono tracking-[0.28em] text-[#E0C6A0] uppercase font-semibold mb-3 sm:mb-4">
                <Sparkles className="w-3.5 h-3.5 text-[#C5A880]" />
                <span>SADDAT ATELIER // 2026 ARCHITECTURAL SUITE</span>
              </div>

              <h1 className="text-3xl sm:text-6xl lg:text-7xl font-light text-white tracking-tight leading-[0.98] mb-4 sm:mb-5">
                Posture, <br />
                <span className="font-serif italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-[#C5A880] via-[#F4E3CB] to-[#E0C6A0]">
                  refined to pure art.
                </span>
              </h1>

              <p className="text-sm sm:text-base text-stone-300 leading-relaxed max-w-lg mb-6 sm:mb-8 font-normal">
                Hand-curated executive ergonomics crafted with aerospace-grade cold kinematics, breathable matrix weave, and bespoke walnut finishes for Pakistan’s finest boardrooms and corporate headquarters.
              </p>

              <div className="grid grid-cols-3 gap-2 sm:gap-4 pt-4 sm:pt-6 border-t border-[#C5A880]/20 mb-6 sm:mb-8 text-[11px] sm:text-xs text-stone-300 font-medium">
                <div className="flex items-center gap-1.5 sm:gap-2">
                  <Award className="w-3.5 h-3.5 text-[#C5A880] shrink-0" />
                  <span className="truncate">BIFMA Certified</span>
                </div>
                <div className="flex items-center gap-1.5 sm:gap-2">
                  <ShieldCheck className="w-3.5 h-3.5 text-[#C5A880] shrink-0" />
                  <span className="truncate">2-Yr Warranty</span>
                </div>
                <div className="flex items-center gap-1.5 sm:gap-2">
                  <CheckCircle2 className="w-3.5 h-3.5 text-emerald-400 shrink-0" />
                  <span className="truncate">Turnkey Setup</span>
                </div>
              </div>

              {/* Magnetic CTA Buttons */}
              <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 sm:gap-4">
                <MagneticButton strength={0.25}>
                  <Link
                    to="/products/chairs"
                    className="inline-flex items-center justify-center gap-2 px-6 sm:px-8 py-3.5 sm:py-4 bg-[#C5A880] hover:bg-[#D4BA93] text-[#180F0A] text-xs uppercase tracking-[0.2em] font-bold transition-all shadow-lg active:scale-95"
                  >
                    <span>Explore Seating Suite</span>
                    <ArrowUpRight className="w-4 h-4 text-[#180F0A]" />
                  </Link>
                </MagneticButton>

                <MagneticButton strength={0.22}>
                  <a
                    href={getGeneralWhatsAppUrl()}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="inline-flex items-center justify-center gap-2 px-6 sm:px-7 py-3.5 sm:py-4 bg-white/5 hover:bg-white/10 text-stone-200 border border-[#C5A880]/40 text-xs uppercase tracking-[0.2em] font-semibold transition-colors backdrop-blur-sm active:scale-95"
                  >
                    <MessageSquare className="w-4 h-4 text-emerald-400" />
                    <span>Corporate WhatsApp Desk</span>
                  </a>
                </MagneticButton>
              </div>

            </div>
          </div>
        </div>

        {/* 6. INTERACTIVE PERSPECTIVE ANGLE CHIPS */}
        <div className="relative z-30 w-full max-w-7xl mx-auto px-4 sm:px-8 lg:px-12 pb-2.5 sm:pb-3 flex items-center justify-center pointer-events-auto">
          <div className="inline-flex items-center gap-1 sm:gap-1.5 p-1 bg-[#1C120B]/90 backdrop-blur-xl border border-[#C5A880]/35 shadow-2xl overflow-x-auto no-scrollbar max-w-full">
            <div className="hidden sm:flex items-center gap-1.5 px-2.5 text-[9px] font-mono uppercase text-stone-400 tracking-wider">
              <Compass className="w-3 h-3 text-[#C5A880]" />
              <span>Perspective:</span>
            </div>

            {ANGLE_PRESETS.map((preset) => {
              const isActive = getIsActivePreset(preset.frame);
              return (
                <button
                  key={preset.degree}
                  onClick={() => handleAngleSelect(preset.frame)}
                  type="button"
                  className={`px-3 py-1.5 sm:px-3.5 sm:py-1.5 rounded-none text-[10px] sm:text-[11px] font-mono tracking-wider transition-all duration-300 flex items-center gap-1.5 select-none whitespace-nowrap ${
                    isActive
                      ? "bg-[#C5A880] text-[#18110B] font-bold shadow-md"
                      : "bg-[#120B07] text-stone-300 hover:text-white hover:bg-[#2A1B12]/80 border border-[#C5A880]/20"
                  }`}
                  title={`Inspect chair from ${preset.degree} perspective`}
                >
                  <span>{preset.label}</span>
                  <span className={`text-[9px] opacity-75 ${isActive ? "text-[#18110B]" : "text-[#C5A880]"}`}>
                    {preset.degree}
                  </span>
                </button>
              );
            })}
          </div>
        </div>

        {/* 7. BOTTOM STATUS STRIP */}
        <footer className="relative z-30 w-full max-w-7xl mx-auto px-5 sm:px-8 lg:px-12 pb-4 sm:pb-5 flex items-center justify-between text-[9px] sm:text-[10px] font-mono tracking-[0.2em] uppercase select-none pointer-events-none text-stone-400">
          <div className="flex items-center gap-2">
            <span className="w-1.5 h-1.5 rounded-full bg-[#C5A880]" />
            <span className="text-stone-200 font-semibold">
              FRAME {String(currentFrame).padStart(3, "0")} / {TOTAL_FRAMES}
            </span>
          </div>

          <div className="hidden sm:flex items-center gap-3 w-48">
            <div className="flex-1 h-[1px] bg-white/10 relative overflow-hidden">
              <div
                className="absolute top-0 left-0 bottom-0 bg-[#C5A880] transition-all duration-75"
                style={{ width: `${Math.round(scrollProgress * 100)}%` }}
              />
            </div>
            <span>{Math.round(scrollProgress * 100)}%</span>
          </div>

          <div className="flex items-center gap-1.5">
            {scrollProgress < 0.72 ? (
              <span className="animate-pulse text-[#C5A880]">DRAG OR SCROLL 360°</span>
            ) : (
              <span className="text-[#E0C6A0] font-bold">ATELIER ACTIVE</span>
            )}
            <ChevronDown className="w-3 h-3" />
          </div>
        </footer>
      </div>
    </div>
  );
}
</file>

<file path="src/components/hero/ProductIntroduction.tsx">
import React, { useEffect, useRef } from "react";
import { Link } from "react-router-dom";
import gsap from "gsap";
import { ScrollTrigger } from "gsap/ScrollTrigger";
import { 
  ArrowUpRight, 
  ShieldCheck, 
  Sparkles, 
  Award, 
  Truck, 
  CheckCircle2, 
  Layers 
} from "lucide-react";
import { CATEGORIES_LIST } from "../../data/furnitureData";
import MagneticButton from "../ui/MagneticButton";

gsap.registerPlugin(ScrollTrigger);

export default function ProductIntroduction() {
  const sectionRef = useRef<HTMLElement | null>(null);
  const headerRef = useRef<HTMLDivElement | null>(null);
  const cardsGridRef = useRef<HTMLDivElement | null>(null);
  const trustBarRef = useRef<HTMLDivElement | null>(null);

  // GSAP ScrollTrigger Animations
  useEffect(() => {
    if (!sectionRef.current) return;

    const ctx = gsap.context(() => {
      // Header Text Reveal
      if (headerRef.current) {
        gsap.fromTo(
          headerRef.current.children,
          { opacity: 0, y: 35 },
          {
            opacity: 1,
            y: 0,
            duration: 0.9,
            stagger: 0.14,
            ease: "power3.out",
            scrollTrigger: {
              trigger: headerRef.current,
              start: "top 85%",
              toggleActions: "play none none reverse",
            },
          }
        );
      }

      // 3 Domain Cards Stagger
      if (cardsGridRef.current) {
        gsap.fromTo(
          cardsGridRef.current.children,
          { opacity: 0, y: 45, scale: 0.97 },
          {
            opacity: 1,
            y: 0,
            scale: 1,
            duration: 0.85,
            stagger: 0.16,
            ease: "power3.out",
            scrollTrigger: {
              trigger: cardsGridRef.current,
              start: "top 82%",
              toggleActions: "play none none reverse",
            },
          }
        );
      }

      // Bottom Trust Pillars Stagger
      if (trustBarRef.current) {
        gsap.fromTo(
          trustBarRef.current.children,
          { opacity: 0, y: 30 },
          {
            opacity: 1,
            y: 0,
            duration: 0.8,
            stagger: 0.12,
            ease: "power2.out",
            scrollTrigger: {
              trigger: trustBarRef.current,
              start: "top 85%",
              toggleActions: "play none none reverse",
            },
          }
        );
      }
    }, sectionRef);

    return () => ctx.revert();
  }, []);

  return (
    <section 
      ref={sectionRef}
      className="relative z-20 w-full bg-[#120B07] text-stone-100 py-24 sm:py-32 border-t border-[#C5A880]/20 overflow-hidden text-left"
    >
      {/* Architectural Background Texture & Ambient Lighting */}
      <div 
        className="absolute inset-0 pointer-events-none opacity-10"
        style={{
          backgroundImage: "repeating-linear-gradient(90deg, rgba(197, 168, 128, 0.1) 0px, rgba(197, 168, 128, 0.1) 1px, transparent 1px, transparent 72px)",
        }}
      />
      <div className="absolute top-0 right-1/4 w-96 h-96 bg-[#C5A880]/10 rounded-full blur-3xl pointer-events-none" />

      <div className="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        {/* 1. Section Header: Walnut & Gold Editorial Interplay */}
        <div 
          ref={headerRef}
          className="flex flex-col md:flex-row md:items-end justify-between gap-8 mb-16 sm:mb-20 pb-8 border-b border-[#C5A880]/20"
        >
          <div className="max-w-xl">
            <div className="inline-flex items-center gap-2 text-[10px] sm:text-xs font-mono tracking-[0.28em] text-[#C5A880] uppercase font-semibold mb-3">
              <Sparkles className="w-3.5 h-3.5 text-[#C5A880]" />
              <span>THE 2026 ATELIER SPECIFICATION</span>
            </div>
            <h2 className="text-3xl sm:text-5xl lg:text-6xl font-light text-white tracking-tight leading-[1.02]">
              Sculpted in timber. <br />
              <span className="font-serif italic font-normal text-transparent bg-clip-text bg-gradient-to-r from-[#C5A880] via-[#F4E3CB] to-[#E0C6A0]">
                Engineered in steel.
              </span>
            </h2>
          </div>

          <div className="max-w-md text-left md:text-right">
            <p className="text-xs sm:text-sm text-stone-300 leading-relaxed font-light mb-6">
              Bespoke executive seating, monolithic conference slabs, and modular workstation systems engineered for high-growth enterprises and C-suite suites across Pakistan.
            </p>
            <MagneticButton strength={0.25}>
              <Link
                to="/products"
                className="inline-flex items-center gap-2 text-xs uppercase tracking-[0.2em] font-semibold text-[#E0C6A0] hover:text-[#C5A880] border-b border-[#C5A880]/40 hover:border-[#C5A880] pb-1 transition-all"
              >
                <span>View Full 2026 Master Catalog</span>
                <ArrowUpRight className="w-3.5 h-3.5 text-[#C5A880]" />
              </Link>
            </MagneticButton>
          </div>
        </div>

        {/* 2. 3 Categories Showcase Grid with Dual-Mode Framing */}
        <div 
          ref={cardsGridRef}
          className="grid grid-cols-1 md:grid-cols-3 gap-8 sm:gap-10"
        >
          {CATEGORIES_LIST.map((cat, idx) => (
            <Link
              key={cat.slug}
              to={`/products/${cat.slug}`}
              className="group block relative focus:outline-none"
            >
              <div className="aspect-[4/3] w-full overflow-hidden bg-[#160E08] border border-[#C5A880]/30 group-hover:border-[#C5A880]/80 mb-6 relative shadow-2xl transition-all duration-500">
                
                {cat.slug === "chairs" ? (
                  /* Mode A (Chairs): 3D Floating Cutout with Golden Halo */
                  <div className="w-full h-full p-6 flex items-center justify-center bg-gradient-to-b from-[#1C120B] to-[#120B07] relative">
                    <div className="absolute bottom-4 w-3/4 h-12 bg-[#C5A880]/15 rounded-full blur-xl pointer-events-none group-hover:bg-[#C5A880]/25 transition-all duration-500" />
                    <img
                      src="/Ergonomic%20Executive%20Chair.png"
                      alt={cat.name}
                      className="max-w-full max-h-full object-contain filter drop-shadow-[0_12px_24px_rgba(0,0,0,0.7)] transform group-hover:scale-108 transition-transform duration-700 ease-out"
                      loading="lazy"
                    />
                  </div>
                ) : (
                  /* Mode B (Desks & Tables): Architectural Digest Photography with Seamless Shadow Blend */
                  <div className="relative w-full h-full">
                    <img
                      src={cat.image}
                      alt={cat.name}
                      className="w-full h-full object-cover object-center transform group-hover:scale-106 transition-transform duration-700 ease-out brightness-[0.88] group-hover:brightness-[0.98] contrast-[1.08]"
                      loading="lazy"
                    />
                    <div className="absolute inset-0 bg-gradient-to-t from-[#160E08] via-transparent to-black/20 pointer-events-none" />
                  </div>
                )}
                
                {/* Gold Top Accent Line */}
                <div className="absolute top-0 left-0 right-0 h-0.5 bg-[#C5A880] opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20" />
                
                {/* Floating Tag */}
                <div className="absolute top-4 left-4 bg-[#18110B]/90 backdrop-blur-md px-3 py-1 text-[10px] font-mono uppercase tracking-[0.2em] text-[#C5A880] border border-[#C5A880]/30 shadow-md z-20">
                  0{idx + 1} // {cat.count}+ Models
                </div>
              </div>

              <div className="flex items-baseline justify-between mb-2">
                <h3 className="text-xl sm:text-2xl font-serif text-white group-hover:text-[#C5A880] transition-colors font-medium">
                  {cat.name}
                </h3>
                <ArrowUpRight className="w-4 h-4 text-stone-400 group-hover:text-[#C5A880] group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
              </div>

              <p className="text-xs text-stone-400 leading-relaxed font-light">
                {cat.description}
              </p>
            </Link>
          ))}
        </div>

        {/* 3. Corporate Trust Credentials Strip */}
        <div 
          ref={trustBarRef}
          className="mt-20 pt-12 border-t border-[#C5A880]/20 grid grid-cols-1 sm:grid-cols-3 gap-8 text-left"
        >
          <div className="flex items-start gap-4 p-5 rounded-none bg-[#1A100A]/60 border border-[#C5A880]/20">
            <span className="text-xs font-mono font-bold text-[#C5A880] uppercase">01</span>
            <div>
              <h4 className="text-sm font-semibold uppercase tracking-wider text-white mb-1.5 flex items-center gap-1.5">
                <Award className="w-4 h-4 text-[#C5A880]" />
                2 to 3-Year Official Warranty
              </h4>
              <p className="text-xs text-stone-400 leading-relaxed font-light">
                Full component replacement coverage on hydraulics, synchro mechanisms, and structural wood joinery.
              </p>
            </div>
          </div>

          <div className="flex items-start gap-4 p-5 rounded-none bg-[#1A100A]/60 border border-[#C5A880]/20">
            <span className="text-xs font-mono font-bold text-[#C5A880] uppercase">02</span>
            <div>
              <h4 className="text-sm font-semibold uppercase tracking-wider text-white mb-1.5 flex items-center gap-1.5">
                <Truck className="w-4 h-4 text-[#C5A880]" />
                Turnkey Nationwide Logistics
              </h4>
              <p className="text-xs text-stone-400 leading-relaxed font-light">
                Insured transit and white-glove corporate assembly teams across Karachi, Lahore, and Islamabad.
              </p>
            </div>
          </div>

          <div className="flex items-start gap-4 p-5 rounded-none bg-[#1A100A]/60 border border-[#C5A880]/20">
            <span className="text-xs font-mono font-bold text-[#C5A880] uppercase">03</span>
            <div>
              <h4 className="text-sm font-semibold uppercase tracking-wider text-white mb-1.5 flex items-center gap-1.5">
                <CheckCircle2 className="w-4 h-4 text-emerald-400" />
                NTN Corporate Volume Pricing
              </h4>
              <p className="text-xs text-stone-400 leading-relaxed font-light">
                Dedicated FBR-compliant GST invoicing, tiered discounts, and free 2D/3D architectural CAD support.
              </p>
            </div>
          </div>

        </div>

      </div>
    </section>
  );
}
