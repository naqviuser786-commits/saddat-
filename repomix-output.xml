                      </span>
                      <button
                        onClick={() => removeFromQuote(item.product.id)}
                        className="text-[10px] font-mono text-rose-400 hover:text-rose-300 flex items-center gap-1 mt-1 ml-auto"
                      >
                        <Trash2 className="w-3 h-3" />
